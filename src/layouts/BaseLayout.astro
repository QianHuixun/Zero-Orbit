---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import CommandSearch from "../components/react/search/CommandSearch";
import { site } from "../data/site";

interface Props {
  title?: string;
  description?: string;
  immersive?: boolean;
}

const title = Astro.props.title ? `${Astro.props.title} | ${site.name}` : site.name;
const description = Astro.props.description ?? site.description;
const immersive = Astro.props.immersive ?? false;
const navItems = [
  { label: "首页", href: "/" },
  { label: "频道", href: "/#channels" },
  { label: "归档", href: "/archive/" },
  { label: "创作", href: "/writing/" },
  { label: "搜索", href: "/search/" },
  { label: "关于", href: "/about/" }
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body class:list={[immersive && "is-immersive"]}>
    <div class="site-shell">
      {!immersive && (
        <header class="container relative z-20 flex items-center justify-between py-5">
          <a href="/" class="group flex items-center gap-3" aria-label={`${site.name} 首页`}>
            <span class="h-3 w-3 rounded-full bg-cyan shadow-glow"></span>
            <span class="font-mono text-sm tracking-[0.18em] text-text/90">{site.name}</span>
          </a>
          <nav class="hidden items-center gap-1 md:flex" aria-label="主导航">
            {navItems.map((item) => (
              <a class="rounded-md px-3 py-2 text-sm text-muted transition hover:bg-panel/80 hover:text-text" href={item.href}>{item.label}</a>
            ))}
          </nav>
        </header>
      )}
      <main class="relative z-10">
        <slot />
        <CommandSearch client:load />
      </main>
      {!immersive && (
        <footer class="container relative z-10 border-t border-line/40 py-10 text-sm text-muted">
          <div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
            <p>© {new Date().getFullYear()} {site.author}. Built as a personal knowledge universe.</p>
            <div class="flex gap-4">
              {site.links.map((link) => <a class="hover:text-cyan" href={link.href}>{link.label}</a>)}
            </div>
          </div>
        </footer>
      )}
    </div>
  </body>
</html>
