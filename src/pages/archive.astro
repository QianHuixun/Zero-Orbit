---
import BaseLayout from "../layouts/BaseLayout.astro";
import ArticleCard from "../components/astro/ArticleCard.astro";
import { getArchiveGroups, getPublishedPosts } from "../lib/content";

const posts = await getPublishedPosts();
const groups = getArchiveGroups(posts);
---

<BaseLayout title="归档" description="按时间回看全部文章。">
  <section class="container py-14 md:py-20">
    <p class="kicker">Archive</p>
    <h1 class="mt-4 text-4xl font-semibold text-text md:text-6xl">归档</h1>
    <div class="mt-10 space-y-10">
      {groups.map((group) => (
        <section>
          <h2 class="mb-4 font-mono text-2xl text-cyan">{group.year}</h2>
          <div class="grid gap-4 md:grid-cols-2">
            {group.posts.map((post) => <ArticleCard post={post} />)}
          </div>
        </section>
      ))}
    </div>
  </section>
</BaseLayout>
