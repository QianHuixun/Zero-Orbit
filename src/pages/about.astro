---
import BaseLayout from "../layouts/BaseLayout.astro";
import { channels } from "../data/channels";
import { site } from "../data/site";
---

<BaseLayout title="关于" description="关于这个个人知识终端。">
  <section class="container py-14 md:py-20">
    <div class="mx-auto max-w-4xl">
      <p class="kicker">About</p>
      <h1 class="mt-4 text-4xl font-semibold text-text md:text-6xl">关于这个知识终端</h1>
      <p class="mt-6 text-xl leading-9 text-muted">{site.description}</p>
      <div class="mt-10 grid gap-4 md:grid-cols-2">
        <div class="panel p-6">
          <h2 class="text-2xl font-semibold text-text">当前关注</h2>
          <div class="mt-5 flex flex-wrap gap-2">
            {site.currentFocus.map((focus) => <span class="rounded-md bg-surface px-3 py-2 text-sm text-muted">{focus}</span>)}
          </div>
        </div>
        <div class="panel p-6">
          <h2 class="text-2xl font-semibold text-text">频道轨道</h2>
          <ul class="mt-5 space-y-3 text-muted">
            {channels.map((channel) => <li><a class="hover:text-cyan" href={`/channels/${channel.slug}/`}>{channel.name} / {channel.description}</a></li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
