---
import { render } from "astro:content";
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import ArticleCard from "../../components/astro/ArticleCard.astro";
import { getAdjacentPosts, getPublishedPosts, getRelatedPosts } from "../../lib/content";
import { postHref } from "../../lib/routes";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const posts = await getPublishedPosts();
const { previous, next } = getAdjacentPosts(posts, post.id);
const relatedPosts = getRelatedPosts(posts, post);
const { Content } = await render(post);
---

<ArticleLayout post={post}>
  <Content />
  <footer class="mt-14 border-t border-line/40 pt-8">
    <div class="grid gap-4 md:grid-cols-2">
      {previous && <a class="panel p-5 hover:border-cyan/50" href={postHref(previous.id)}><span class="text-sm text-muted">上一篇</span><strong class="mt-2 block text-text">{previous.data.title}</strong></a>}
      {next && <a class="panel p-5 hover:border-cyan/50" href={postHref(next.id)}><span class="text-sm text-muted">下一篇</span><strong class="mt-2 block text-text">{next.data.title}</strong></a>}
    </div>
    {relatedPosts.length > 0 && (
      <section class="mt-10">
        <h2 class="text-2xl font-semibold text-text">相关记录</h2>
        <div class="mt-4 grid gap-4 not-prose md:grid-cols-3">
          {relatedPosts.map((related) => <ArticleCard post={related} />)}
        </div>
      </section>
    )}
  </footer>
</ArticleLayout>
