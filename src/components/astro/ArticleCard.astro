---
import { formatDate, type Post } from "../../lib/content";
import { getChannel } from "../../data/channels";
import { channelHref, postHref, tagHref } from "../../lib/routes";

interface Props {
  post: Post;
  featured?: boolean;
}

const { post, featured = false } = Astro.props;
const channel = getChannel(post.data.channel);
---

<article class:list={["panel group p-5 transition hover:border-cyan/50 hover:shadow-glow", featured && "md:p-6"]}>
  <div class="mb-4 flex flex-wrap items-center gap-3 text-xs text-muted">
    {channel && <a class="text-cyan hover:text-text" href={channelHref(channel.slug)}>{channel.name}</a>}
    <time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt)}</time>
  </div>
  <h3 class:list={["font-semibold tracking-normal text-text group-hover:text-cyan", featured ? "text-2xl" : "text-xl"]}>
    <a href={postHref(post.id)}>{post.data.title}</a>
  </h3>
  <p class="mt-3 leading-7 text-muted">{post.data.summary}</p>
  <div class="mt-5 flex flex-wrap gap-2">
    {post.data.tags.slice(0, 4).map((tag) => <a class="rounded-md bg-surface/80 px-2 py-1 text-xs text-muted hover:text-cyan" href={tagHref(tag)}>{tag}</a>)}
  </div>
</article>
